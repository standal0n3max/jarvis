# Скопируйте в файл вне git и подставьте свои значения.
# Этот пример в репозитории. Файлы *.env, plans/ и credentials/ в git не входят.

OPENROUTER_API_KEY=
OPENROUTER_KEY_CREDIT_LIMIT_USD=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_OWNER_ID=
TELEGRAM_OWNER_USERNAME=

# Путь внутри remote dropbox, без префикса dropbox:.
# Пример: Apps/My Vault
DROPBOX_DEST=

GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Таблица бюджета. Сам ключ — отдельный JSON сервисного аккаунта.
# На сервер кладутся вручную, update.sh их не копирует:
#   /home/openclaw/.openclaw/google-sheets.json
#   /home/openclaw/.openclaw/google-sheets.env
# В env одна строка: GOOGLE_SHEETS_SPREADSHEET_ID=
# Живой openclaw.json скрипт обновления не переписывает.
# Сервер sheets туда добавляется отдельно, затем перезапуск gateway.
