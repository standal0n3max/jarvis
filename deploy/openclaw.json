{
  "agents": {
    "entries": {
      "main": {
        "name": "main",
        "workspace": "/home/openclaw/vault",
        "identity": {
          "name": "main"
        }
      }
    },
    "defaults": {
      "workspace": "/home/openclaw/vault",
      "skipBootstrap": true,
      "models": {
        "openrouter/anthropic/claude-haiku-5.5": {
          "alias": "haiku",
          "params": {
            "provider": {
              "order": ["anthropic"],
              "allow_fallbacks": false
            }
          }
        },
        "openrouter/anthropic/claude-sonnet-5.5": {
          "alias": "sonnet",
          "params": {
            "provider": {
              "order": ["anthropic"],
              "allow_fallbacks": false
            }
          }
        }
      },
      "model": {
        "primary": "openrouter/anthropic/claude-haiku-5.5"
      },
      "thinkingDefault": "low",
      "heartbeat": {
        "every": "0m",
        "target": "none"
      },
      "imageModel": {
        "primary": "openrouter/anthropic/claude-sonnet-5.5"
      }
    }
  },
  "plugins": {
    "entries": {
      "openrouter": {
        "enabled": true
      }
    }
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "token"
    },
    "port": 18789,
    "bind": "loopback",
    "tailscale": {
      "mode": "off"
    }
  },
  "tools": {
    "profile": "full",
    "deny": ["browser", "exec"],
    "fs": {
      "workspaceOnly": true
    },
    "media": {
      "models": [
        {
          "provider": "openrouter",
          "model": "openai/whisper-large-v3-turbo",
          "capabilities": ["audio"]
        },
        {
          "provider": "openrouter",
          "model": "anthropic/claude-sonnet-5.5",
          "capabilities": ["image"]
        }
      ],
      "audio": {
        "enabled": true,
        "preferredModel": "openrouter/openai/whisper-large-v3-turbo"
      },
      "image": {
        "enabled": true,
        "preferredModel": "openrouter/anthropic/claude-sonnet-5.5"
      }
    }
  },
  "auth": {
    "profiles": {
      "openrouter:default": {
        "provider": "openrouter",
        "mode": "api_key"
      }
    }
  },
  "models": {
    "providers": {
      "openrouter": {
        "params": {
          "provider": {
            "data_collection": "deny"
          }
        }
      }
    }
  },
  "hooks": {
    "internal": {
      "enabled": true,
      "entries": {
        "bootstrap-extra-files": {
          "enabled": true,
          "paths": ["system/AGENTS.md"]
        }
      }
    }
  },
  "channels": {
    "telegram": {
      "name": "REPLACE_ME",
      "enabled": true,
      "dmPolicy": "allowlist",
      "allowFrom": ["tg:REPLACE_ME"],
      "groupPolicy": "disabled"
    }
  },
  "mcp": {
    "servers": {
      "calendar": {
        "enabled": false,
        "url": "https://calendarmcp.googleapis.com/mcp/v1",
        "transport": "streamable-http",
        "auth": "oauth",
        "oauth": {
          "scope": "https://www.googleapis.com/auth/calendar"
        }
      },
      "calendar-v3": {
        "command": "/usr/bin/node",
        "args": ["/home/openclaw/.openclaw/calendar-v3-mcp.mjs"]
      },
      "sheets": {
        "command": "/usr/bin/node",
        "args": ["/home/openclaw/.openclaw/sheets-mcp.mjs"]
      }
    }
  }
}
